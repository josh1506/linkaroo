# Copy to .env (git-ignored) and fill in. Names only - never commit real values.
SECRET_KEY=
DEBUG=False                 # true/false; parsed as a real boolean
PRODUCTION=False
DJANGO_ALLOWED_HOSTS=       # space-separated, staging/production only

# Production database (config/settings/production.py)
DB_NAME=linkaroo
DB_USER=linkaroouser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Transport security (defaults shown; local.py turns redirect/secure cookies off)
SECURE_SSL_REDIRECT=True
SECURE_COOKIES=True
SECURE_HSTS_SECONDS=0       # raise to 3600, then 31536000, once HTTPS is confirmed
BEHIND_TLS_PROXY=False      # True if a proxy terminates TLS and sets X-Forwarded-Proto

# Logging (stderr)
LOG_LEVEL=WARNING
DJANGO_LOG_LEVEL=ERROR       # WARNING also logs every 404/405 (noisy on a public shortener)

# Content-Security-Policy: True sends Report-Only (staged rollout)
CSP_REPORT_ONLY=False

# Abuse limits (config/settings/base.py; threat model F3-F5)
TRUSTED_PROXY_COUNT=0             # number of reverse proxies appending X-Forwarded-For; MUST be set behind a proxy
CLICK_RECORD_LIMIT_PER_MINUTE=30  # clicks recorded per client per link per minute (redirect is never blocked); 0 = no cap
SIGNUPS_PER_CLIENT_PER_HOUR=5
